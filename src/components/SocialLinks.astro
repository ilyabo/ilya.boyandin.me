---
interface Props {
  icons?: boolean;
}

const { icons = false } = Astro.props;
const links = [
  { label: 'Email', href: 'mailto:ilya@boyandin.me' },
  { label: 'GitHub', href: 'https://github.com/ilyabo' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/ilyabo/' },
];
---

<nav class={icons ? 'header-social' : undefined} aria-label="Social links">
  {links.map(({ label, href }) => (
    <a
      href={href}
      target={href.startsWith('https:') ? '_blank' : undefined}
      rel={href.startsWith('https:') ? 'noopener' : undefined}
      data-tooltip={icons ? label : undefined}
    >
      <span class={icons ? 'sr-only' : undefined}>{label}</span>
      {icons && (
        <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
          {label === 'Email' && <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="2" y="4.5" width="20" height="15" rx="2" /><path d="m3 6 9 7 9-7" /></g>}
          {label === 'GitHub' && <path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.68.08-.68 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.23 1.16-3.01-.12-.29-.5-1.43.11-2.98 0 0 .95-.3 3.09 1.15a10.7 10.7 0 0 1 5.63 0c2.15-1.45 3.09-1.15 3.09-1.15.61 1.55.23 2.69.11 2.98.72.78 1.16 1.78 1.16 3.01 0 4.33-2.64 5.28-5.15 5.56.41.35.76 1.03.76 2.08v3.1c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z" />}
          {label === 'LinkedIn' && <path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.46 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85h-2.95v-4.64c0-1.1-.02-2.53-1.54-2.53-1.55 0-1.78 1.21-1.78 2.45v4.72H9.54V9.2h2.83v1.31h.04c.39-.75 1.36-1.54 2.8-1.54 2.99 0 3.55 1.97 3.55 4.53v5.25Z" />}
        </svg>
      )}
    </a>
  ))}
</nav>
