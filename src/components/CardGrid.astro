---
import type { ContentEntry } from '../lib/content';
import { formatDate } from '../lib/format';
import { previewMediaPath } from '../lib/media';

interface Props {
  entries: ContentEntry[];
}

const { entries } = Astro.props;
---

<div class="content-grid grid gap-6 sm:gap-7">
  {
    entries.map((entry) => {
      const preview = previewMediaPath(entry);

      return (
        <a class="content-card grid min-w-0 overflow-hidden rounded-xl border" href={entry.route} data-keywords={JSON.stringify(entry.keywords)}>
          <div class="card-heading flex items-baseline justify-between gap-3">
            <h2 data-search-title>{entry.title}</h2>
            <span>{formatDate(entry.date)}</span>
          </div>
          <div class="preview-frame">
            {preview ? <img src={preview} alt={`${entry.title} preview`} loading="lazy" /> : null}
          </div>
        </a>
      );
    })
  }
</div>
