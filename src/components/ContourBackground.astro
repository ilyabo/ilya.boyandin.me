<canvas class="contour-background" transition:persist="contour-background" transition:animate="none" aria-hidden="true"></canvas>

<style>
  .contour-background {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media print {
    .contour-background { display: none; }
  }
</style>

<script>
  import { ContourHills } from '../lib/contour-hills';
  import { clearStoredTerrain, loadTerrain, saveHill } from '../lib/contour-storage';
  import { ContourSprings } from '../lib/contour-springs';

  import { terrainVertexSource, contourFragmentSource } from '../lib/contour-shaders';
  import { TerrainExplorer, terrainSpan } from '../lib/terrain-explorer';

  function renderContours(canvas: HTMLCanvasElement, hills: ContourHills) {
    const gl = canvas.getContext('webgl2', {
      antialias: false, depth: true, stencil: false, premultipliedAlpha: true,
      powerPreference: 'low-power',
    });
    if (!gl) return;

    const program = gl.createProgram();
    for (const [type, source] of [[gl.VERTEX_SHADER, terrainVertexSource], [gl.FRAGMENT_SHADER, contourFragmentSource]] as const) {
      const shader = gl.createShader(type);
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      gl.attachShader(program, shader);
      gl.deleteShader(shader);
    }
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      gl.deleteProgram(program);
      return;
    }
    gl.useProgram(program);
    const resolution = gl.getUniformLocation(program, 'resolution');
    const gutter = gl.getUniformLocation(program, 'gutter');
    const viewport = gl.getUniformLocation(program, 'viewport');
    const springsActive = gl.getUniformLocation(program, 'springsActive');
    for (const [unit, name] of ['springField', 'hillField'].entries()) {
      gl.activeTexture(gl.TEXTURE0 + unit);
      gl.bindTexture(gl.TEXTURE_2D, gl.createTexture());
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      gl.uniform1i(gl.getUniformLocation(program, name), unit);
    }
    gl.pixelStorei(gl.UNPACK_ALIGNMENT, 1);
    const time = gl.getUniformLocation(program, 'elapsed');
    const touchMotion = gl.getUniformLocation(program, 'touchMotion');
    const coarsePointer = matchMedia('(pointer: coarse)');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const listeners = new AbortController();
    const options = { signal: listeners.signal };
    const paintMode = gl.getUniformLocation(program, 'paintMode');
    const fieldSpan = gl.getUniformLocation(program, 'fieldSpan');
    let main: HTMLElement;
    let palette: HTMLFieldSetElement | null;
    let touchBrush: HTMLSelectElement | null;
    let paint = false;
    let explorer: TerrainExplorer | undefined;
    let pageListeners: AbortController;
    let springs: ContourSprings;
    let previousPointer: PointerEvent | null = null;
    let press: PointerEvent | null = null;
    let brushMap: ReturnType<TerrainExplorer['captureBrushMap']> | null = null;
    let strokeOrigin = { x: 0, y: 0 };
    let dragging = false;
    const touchDragDelayMs = 250;
    let frame = 0;
    let lastDraw = 0;
    let elapsed = 0;
    function bindPage() {
      endStroke();
      pageListeners?.abort();
      pageListeners = new AbortController();
      main = document.querySelector<HTMLElement>('.site-main');
      palette = main.querySelector<HTMLFieldSetElement>('[data-paint-palette]');
      touchBrush = palette?.querySelector<HTMLSelectElement>('[data-touch-brush]');
      paint = !!palette;
      gl.uniform1i(paintMode, Number(paint));
      const exploreButton = palette?.querySelector<HTMLButtonElement>('[data-explore-terrain]');
      explorer = exploreButton && new TerrainExplorer(gl, program, main, exploreButton, scheduleDraw,
        commit => commit && press ? finishStroke(performance.now()) : endStroke(), pageListeners.signal);
      const resetButton = palette?.querySelector<HTMLButtonElement>('[data-reset-terrain]');
      if (resetButton) {
        resetButton.addEventListener('click', () => {
          endStroke();
          hills.clear();
          clearStoredTerrain();
          if (explorer?.active) explorer.setActive(false);
          resetSprings();
        }, { signal: pageListeners.signal });
        resetButton.disabled = false;
        pageListeners.signal.addEventListener('abort', () => { resetButton.disabled = true; }, { once: true });
      }
      const saveButton = palette?.querySelector<HTMLButtonElement>('[data-save-image]');
      if (saveButton) {
        saveButton.addEventListener('click', saveImage, { signal: pageListeners.signal });
        saveButton.disabled = false;
        pageListeners.signal.addEventListener('abort', () => { saveButton.disabled = true; }, { once: true });
      }
      resize();
      scheduleDraw();
    }

    function draw(now: number) {
      frame = 0;
      if (!reducedMotion.matches) {
        scheduleDraw();
        if (lastDraw && now - lastDraw < 1000 / 30 - 0.5) return;
        const dt = lastDraw ? Math.min(now - lastDraw, 100) / 1000 : 0;
        elapsed += dt;
        if (springs.active) {
          springs.step(dt);
          gl.activeTexture(gl.TEXTURE0);
          gl.texSubImage2D(gl.TEXTURE_2D, 0, 0, 0, springs.columns, springs.rows, gl.RG, gl.UNSIGNED_BYTE, springs.pixels);
        }
      }
      explorer?.step(now, reducedMotion.matches);
      const span = explorer?.showingTerrain ? terrainSpan : 1;
      if (span !== hills.fieldSpan) resizeHillField(span);
      const hillPixels = hills.update(now, reducedMotion.matches);
      if (hillPixels) {
        gl.activeTexture(gl.TEXTURE1);
        gl.texSubImage2D(gl.TEXTURE_2D, 0, 0, 0, hills.columns, hills.rows, gl.RGBA, gl.FLOAT, hillPixels);
        if (hills.active) scheduleDraw();
      }
      lastDraw = now;
      gl.uniform1i(springsActive, springs.active ? 1 : 0);
      gl.uniform1f(time, elapsed);
      gl.uniform1f(touchMotion, coarsePointer.matches ? 1 : 0);
      drawScene();
    }

    function drawScene() {
      if (explorer?.showingTerrain) explorer.draw();
      else gl.drawArrays(gl.TRIANGLES, 0, 3);
    }

    function scheduleDraw() {
      if (!document.hidden && !frame) frame = requestAnimationFrame(draw);
    }

    function saveImage() {
      const snapshot = document.createElement('canvas');
      snapshot.width = canvas.width;
      snapshot.height = canvas.height;
      const context = snapshot.getContext('2d', { alpha: false });
      if (!context) return;
      context.fillStyle = getComputedStyle(document.documentElement).backgroundColor;
      context.fillRect(0, 0, snapshot.width, snapshot.height);
      // WebGL can discard its drawing buffer after display. Redraw the current frame before copying.
      drawScene();
      context.drawImage(canvas, 0, 0);
      snapshot.toBlob((blob) => {
        if (!blob) return;
        const url = URL.createObjectURL(blob);
        const download = document.createElement('a');
        download.href = url;
        download.download = 'contour-terrain.png';
        document.body.append(download);
        download.click();
        download.remove();
        window.setTimeout(() => URL.revokeObjectURL(url), 60_000);
      }, 'image/png');
    }

    function resetSprings() {
      previousPointer = null;
      springs = new ContourSprings(canvas.clientWidth, canvas.clientHeight);
      gl.activeTexture(gl.TEXTURE0);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RG8, springs.columns, springs.rows, 0, gl.RG, gl.UNSIGNED_BYTE, springs.pixels);
      scheduleDraw();
    }

    function resize() {
      const density = Math.min(devicePixelRatio, 1);
      const width = Math.round(canvas.clientWidth * density);
      const height = Math.round(canvas.clientHeight * density);
      const inset = main.getBoundingClientRect().left + parseFloat(getComputedStyle(main).paddingLeft);
      gl.uniform1f(gutter, Math.max(1, inset) / canvas.clientWidth);
      if (springs && canvas.width === width && canvas.height === height) return;
      endStroke();
      canvas.width = width;
      canvas.height = height;
      gl.viewport(0, 0, width, height);
      gl.uniform2f(resolution, width, height);
      gl.uniform2f(viewport, canvas.clientWidth, canvas.clientHeight);
      resizeHillField(explorer?.showingTerrain ? terrainSpan : 1);
      resetSprings();
      explorer?.resize();
    }

    function resizeHillField(span: number) {
      hills.resize(canvas.clientWidth, canvas.clientHeight, span);
      gl.uniform1f(fieldSpan, span);
      gl.activeTexture(gl.TEXTURE1);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA16F, hills.columns, hills.rows, 0, gl.RGBA, gl.FLOAT, null);
    }

    function isBackgroundPress(event: PointerEvent) {
      return !event.defaultPrevented && event.isPrimary && event.button === 0 &&
        (!paint || event.target === main) &&
        !event.composedPath().some((el) => el instanceof Element && el.matches(
          'a, button, input, textarea, select, label, summary, [role="button"], [role="search"], [role="listbox"], [contenteditable], audio, video',
        ));
    }

    function updateDrag(event: PointerEvent) {
      if (press?.pointerId !== event.pointerId) return;
      const dx = event.clientX - press.clientX;
      const dy = event.clientY - press.clientY;
      if (!dragging && Math.hypot(dx, dy) <= 10) return;
      if (!paint && press.pointerType === 'touch' && event.timeStamp - press.timeStamp < touchDragDelayMs) {
        cancelPress();
        return;
      }
      dragging = true;
      if (brushMap) {
        const point = brushMap(event.clientX, event.clientY);
        if (!point) {
          finishStroke(event.timeStamp);
          return;
        }
        hills.drag(point.x - strokeOrigin.x, point.y - strokeOrigin.y, event.type === 'pointerup');
      } else {
        hills.drag(dx, dy, event.type === 'pointerup');
      }
      scheduleDraw();
    }

    function handleTouchMove(event: TouchEvent) {
      // A deliberate hold claims the following drag. An immediate swipe scrolls normally.
      if (press && event.touches.length === 1 && event.cancelable &&
          event.timeStamp - press.timeStamp >= touchDragDelayMs) event.preventDefault();
    }

    window.addEventListener('pointerdown', (event) => {
      if (press) cancelPress();
      if (!isBackgroundPress(event)) return;
      const bounds = canvas.getBoundingClientRect();
      if (explorer?.active || explorer?.showingTerrain) {
        if (!explorer.readyToDraw) return;
        const project = explorer.captureBrushMap(canvas);
        const point = project(event.clientX, event.clientY);
        if (!point) return;
        brushMap = project;
        strokeOrigin = point;
      } else {
        strokeOrigin = { x: event.clientX - bounds.left, y: event.clientY - bounds.top };
      }
      press = event;
      dragging = false;
      if (!paint && event.pointerType === 'touch') {
        window.addEventListener('touchmove', handleTouchMove, { ...options, passive: false });
      }
      const swatch = palette?.querySelector<HTMLInputElement>('input[name="brush-color"]:checked');
      const rgb = swatch ? parseInt(swatch.value.slice(1), 16) : null;
      const valley = event.shiftKey || (event.pointerType !== 'mouse' && touchBrush?.value === 'valley');
      hills.begin(strokeOrigin.x, strokeOrigin.y, event.timeStamp,
        rgb === null ? undefined : [(rgb >> 16) / 255, ((rgb >> 8) & 255) / 255, (rgb & 255) / 255], valley);
      scheduleDraw();
    }, options);

    function cancelPress() {
      if (!press) return;
      press = null;
      brushMap = null;
      window.removeEventListener('touchmove', handleTouchMove);
      hills.cancel();
      scheduleDraw();
    }

    function finishStroke(now: number) {
      press = null;
      brushMap = null;
      window.removeEventListener('touchmove', handleTouchMove);
      hills.release(now, reducedMotion.matches);
      scheduleDraw();
    }

    window.addEventListener('pointerup', (event) => {
      if (press?.pointerId !== event.pointerId) return;
      updateDrag(event);
      if (!press) return;
      if (event.defaultPrevented || (!dragging && !isBackgroundPress(event))) return cancelPress();
      finishStroke(event.timeStamp);
    }, options);

    window.addEventListener('pointermove', (event) => {
      if (press?.pointerId === event.pointerId) {
        for (const sample of event.getCoalescedEvents?.() ?? []) updateDrag(sample);
      }
      updateDrag(event);
      if (explorer?.active || explorer?.showingTerrain) {
        previousPointer = null;
        return;
      }
      if (reducedMotion.matches || event.pointerType === 'touch') return;
      if (previousPointer?.pointerId === event.pointerId) {
        springs.stroke(
          previousPointer.clientX, previousPointer.clientY, event.clientX, event.clientY,
          event.timeStamp - previousPointer.timeStamp,
        );
      }
      previousPointer = event;
    }, options);

    function endStroke() {
      previousPointer = null;
      cancelPress();
    }
    window.addEventListener('pointercancel', endStroke, options);
    document.documentElement.addEventListener('pointerleave', endStroke, options);
    window.addEventListener('blur', endStroke, options);
    reducedMotion.addEventListener('change', resetSprings, options);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelPress();
      cancelAnimationFrame(frame);
      frame = 0;
      lastDraw = 0;
      resetSprings();
    }, options);
    window.addEventListener('resize', resize, options);
    document.addEventListener('astro:after-swap', bindPage, options);
    canvas.addEventListener('webglcontextlost', (event) => {
      event.preventDefault();
      pageListeners.abort();
      listeners.abort();
      cancelAnimationFrame(frame);
    }, options);
    bindPage();
  }

  const canvas = document.querySelector<HTMLCanvasElement>('.contour-background');
  if (canvas) {
    const hills = new ContourHills(loadTerrain(), saveHill);
    canvas.addEventListener('webglcontextrestored', () => renderContours(canvas, hills));
    renderContours(canvas, hills);
  }
</script>
