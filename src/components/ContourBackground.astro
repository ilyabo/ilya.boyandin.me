---
interface Props { paint?: boolean }
const { paint = false } = Astro.props;
---
<canvas class="contour-background" data-paint={paint || undefined} aria-hidden="true"></canvas>

<style>
  .contour-background {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media print {
    .contour-background { display: none; }
  }
</style>

<script>
  import { ContourHills } from '../lib/contour-hills';
  import { ContourSprings } from '../lib/contour-springs';

  const vertexSource = `#version 300 es
    void main() {
      const vec2 corners[3] = vec2[3](vec2(-1, -1), vec2(3, -1), vec2(-1, 3));
      gl_Position = vec4(corners[gl_VertexID], 0, 1);
    }
  `;

  const fragmentSource = `#version 300 es
    precision highp float;
    uniform vec2 resolution;
    uniform float gutter;
    uniform sampler2D springField;
    uniform highp sampler2D hillField;
    uniform bool springsActive;
    uniform bool paintMode;
    uniform vec2 viewport;
    uniform float elapsed;
    uniform float touchMotion;
    out vec4 color;

    float cornerHeight(vec2 cell) {
      vec3 h = fract(cell.xyx * vec3(0.1031, 0.1030, 0.0973));
      h += dot(h, h.yzx + 33.33);
      return fract((h.x + h.y) * h.z);
    }

    float terrainNoise(vec2 p) {
      vec2 cell = floor(p);
      vec2 f = fract(p);
      vec2 blend = f*f*f * (f*(f*6.0 - 15.0) + 10.0);
      return mix(
        mix(cornerHeight(cell), cornerHeight(cell + vec2(1, 0)), blend.x),
        mix(cornerHeight(cell + vec2(0, 1)), cornerHeight(cell + vec2(1, 1)), blend.x),
        blend.y
      );
    }

    vec2 samplePull(vec2 uv) {
      // Group the 4x4 cubic B-spline kernel into four hardware-filtered reads.
      vec2 size = vec2(textureSize(springField, 0));
      vec2 cell = uv * size - 0.5;
      vec2 f = fract(cell);
      vec2 r = 1.0 - f;
      vec2 w0 = r * r * r / 6.0;
      vec2 w1 = (4.0 - 6.0 * f * f + 3.0 * f * f * f) / 6.0;
      vec2 w3 = f * f * f / 6.0;
      vec2 left = w0 + w1;
      vec2 right = 1.0 - left;
      vec2 lo = (floor(cell) - 0.5 + w1 / left) / size;
      vec2 hi = (floor(cell) + 1.5 + w3 / right) / size;
      vec2 lower = mix(texture(springField, lo).rg, texture(springField, vec2(hi.x, lo.y)).rg, right.x);
      vec2 upper = mix(texture(springField, vec2(lo.x, hi.y)).rg, texture(springField, hi).rg, right.x);
      return (mix(lower, upper, right.y) * 255.0 - 128.0) / 3.0;
    }

    void main() {
      vec2 uv = gl_FragCoord.xy / resolution;
      vec2 scale = resolution / max(resolution.x, resolution.y * 0.86);
      vec2 p = uv * scale;
      float margin = smoothstep(0.30, 0.50, abs(uv.x - 0.5));
      float motion = mix(0.35, 1.0, margin) + 1.2 * touchMotion;
      float edgeDistance = min(uv.x, 1.0 - uv.x);
      float outerMargin = 1.0 - smoothstep(0.0, gutter, edgeDistance);

      // Sample the resting terrain in the opposite direction of the local pull.
      if (springsActive) {
        vec2 pull = samplePull(vec2(uv.x, 1.0 - uv.y));
        p -= vec2(pull.x, -pull.y) * scale / viewport;
      }

      // Rotated layers of relief produce nested summits, saddles and drainage valleys.
      mat2 turn = mat2(0.8, 0.6, -0.6, 0.8);
      vec2 terrain = turn * (p * 3.4) + vec2(6.2, 3.8);
      float hills = terrainNoise(terrain);
      float ridges = terrainNoise(turn * terrain * 2.1);
      float elevation = hills + 0.34 * ridges
                      + 0.10 * terrainNoise(terrain * 4.7 + 9.0);
      vec2 mapUV = p / scale;
      vec4 hill = texture(hillField, vec2(mapUV.x, 1.0 - mapUV.y));
      elevation += hill.r;
      // On touch screens, carry the breath into the reading area between the narrow gutters.
      float breath = sin(elapsed * mix(0.24, 0.48, touchMotion));
      float relief = 0.040 * (hills - 0.5) + 0.028 * (ridges - 0.5);
      elevation += breath * (motion + 0.45 * outerMargin) * (relief + 0.018 * touchMotion);
      float level = elevation * 21.0;
      bool indexContour = mod(floor(level + 0.5), 5.0) == 0.0;
      float distanceToLine = abs(fract(level + 0.5) - 0.5);
      float pixelWidth = max(fwidth(level), 0.0001);
      float width = indexContour ? 1.25 : 0.95;
      float line = 1.0 - smoothstep(0.0, width, distanceToLine / pixelWidth);
      float readingFade = mix(1.0, mix(0.36, 0.52, touchMotion), clamp(edgeDistance / (gutter + 0.04), 0.0, 1.0));
      vec3 contourColor = vec3(0.43, 0.67, 0.70);
      float opacity = (indexContour ? 0.19 : 0.13) * readingFade;
      vec4 contour = vec4(contourColor * opacity, opacity);
      if (paintMode) {
        vec3 ink = hill.gba;
        float strength = max(ink.r, max(ink.g, ink.b));
        float baseOpacity = (indexContour ? 0.31 : 0.19) * (1.0 - strength);
        contour = vec4(ink + contourColor * baseOpacity, strength + baseOpacity);
      }
      color = contour * line;
    }
  `;

  function renderContours(canvas: HTMLCanvasElement) {
    const gl = canvas.getContext('webgl2', {
      antialias: false, depth: false, stencil: false, premultipliedAlpha: true,
      powerPreference: 'low-power',
    });
    if (!gl) return;

    const program = gl.createProgram();
    for (const [type, source] of [[gl.VERTEX_SHADER, vertexSource], [gl.FRAGMENT_SHADER, fragmentSource]] as const) {
      const shader = gl.createShader(type);
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      gl.attachShader(program, shader);
      gl.deleteShader(shader);
    }
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      gl.deleteProgram(program);
      return;
    }
    gl.useProgram(program);
    const resolution = gl.getUniformLocation(program, 'resolution');
    const gutter = gl.getUniformLocation(program, 'gutter');
    const viewport = gl.getUniformLocation(program, 'viewport');
    const springsActive = gl.getUniformLocation(program, 'springsActive');
    const paint = canvas.hasAttribute('data-paint');
    for (const [unit, name] of ['springField', 'hillField'].entries()) {
      gl.activeTexture(gl.TEXTURE0 + unit);
      gl.bindTexture(gl.TEXTURE_2D, gl.createTexture());
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      gl.uniform1i(gl.getUniformLocation(program, name), unit);
    }
    gl.pixelStorei(gl.UNPACK_ALIGNMENT, 1);
    const time = gl.getUniformLocation(program, 'elapsed');
    const touchMotion = gl.getUniformLocation(program, 'touchMotion');
    const coarsePointer = matchMedia('(pointer: coarse)');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const listeners = new AbortController();
    const options = { signal: listeners.signal };
    const main = document.querySelector<HTMLElement>('.site-main');
    const palette = document.querySelector<HTMLFieldSetElement>('[data-paint-palette]');
    const saveButton = palette?.querySelector<HTMLButtonElement>('[data-save-image]');
    const hills = new ContourHills(paint ? 4 : 1);
    const hillFormat = paint ? gl.RGBA : gl.RED;
    gl.uniform1i(gl.getUniformLocation(program, 'paintMode'), paint ? 1 : 0);
    let springs: ContourSprings;
    let previousPointer: PointerEvent | null = null;
    let press: PointerEvent | null = null;
    let dragging = false;
    const touchDragDelayMs = 250;
    let frame = 0;
    let lastDraw = 0;
    let elapsed = 0;

    function draw(now: number) {
      frame = 0;
      if (!reducedMotion.matches) {
        scheduleDraw();
        if (lastDraw && now - lastDraw < 1000 / 30 - 0.5) return;
        const dt = lastDraw ? Math.min(now - lastDraw, 100) / 1000 : 0;
        elapsed += dt;
        if (springs.active) {
          springs.step(dt);
          gl.activeTexture(gl.TEXTURE0);
          gl.texSubImage2D(gl.TEXTURE_2D, 0, 0, 0, springs.columns, springs.rows, gl.RG, gl.UNSIGNED_BYTE, springs.pixels);
        }
      }
      const hillPixels = hills.update(now, reducedMotion.matches);
      if (hillPixels) {
        gl.activeTexture(gl.TEXTURE1);
        gl.texSubImage2D(gl.TEXTURE_2D, 0, 0, 0, hills.columns, hills.rows, hillFormat, gl.FLOAT, hillPixels);
        if (hills.active) scheduleDraw();
      }
      lastDraw = now;
      gl.uniform1i(springsActive, springs.active ? 1 : 0);
      gl.uniform1f(time, elapsed);
      gl.uniform1f(touchMotion, coarsePointer.matches ? 1 : 0);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }

    function scheduleDraw() {
      if (!document.hidden && !frame) frame = requestAnimationFrame(draw);
    }

    function saveImage() {
      const snapshot = document.createElement('canvas');
      snapshot.width = canvas.width;
      snapshot.height = canvas.height;
      const context = snapshot.getContext('2d', { alpha: false });
      if (!context) return;
      context.fillStyle = getComputedStyle(document.documentElement).backgroundColor;
      context.fillRect(0, 0, snapshot.width, snapshot.height);
      // WebGL can discard its drawing buffer after display. Redraw the current frame before copying.
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      context.drawImage(canvas, 0, 0);
      snapshot.toBlob((blob) => {
        if (!blob) return;
        const url = URL.createObjectURL(blob);
        const download = document.createElement('a');
        download.href = url;
        download.download = 'contour-terrain.png';
        document.body.append(download);
        download.click();
        download.remove();
        window.setTimeout(() => URL.revokeObjectURL(url), 60_000);
      }, 'image/png');
    }

    function resetSprings() {
      previousPointer = null;
      springs = new ContourSprings(canvas.clientWidth, canvas.clientHeight);
      gl.activeTexture(gl.TEXTURE0);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RG8, springs.columns, springs.rows, 0, gl.RG, gl.UNSIGNED_BYTE, springs.pixels);
      scheduleDraw();
    }

    function resize() {
      const density = Math.min(devicePixelRatio, 1);
      canvas.width = Math.round(canvas.clientWidth * density);
      canvas.height = Math.round(canvas.clientHeight * density);
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(resolution, canvas.width, canvas.height);
      gl.uniform2f(viewport, canvas.clientWidth, canvas.clientHeight);
      const inset = main.getBoundingClientRect().left + parseFloat(getComputedStyle(main).paddingLeft);
      gl.uniform1f(gutter, Math.max(1, inset) / canvas.clientWidth);
      hills.resize(canvas.clientWidth, canvas.clientHeight);
      gl.activeTexture(gl.TEXTURE1);
      gl.texImage2D(gl.TEXTURE_2D, 0, paint ? gl.RGBA16F : gl.R16F, hills.columns, hills.rows, 0, hillFormat, gl.FLOAT, null);
      resetSprings();
    }

    function isBackgroundPress(event: PointerEvent) {
      return !event.defaultPrevented && event.isPrimary && event.button === 0 &&
        (!paint || event.target === main) &&
        !event.composedPath().some((el) => el instanceof Element && el.matches(
          'a, button, input, textarea, select, label, summary, [role="button"], [role="search"], [role="listbox"], [contenteditable], audio, video',
        ));
    }

    function updateDrag(event: PointerEvent) {
      if (press?.pointerId !== event.pointerId) return;
      const dx = event.clientX - press.clientX;
      const dy = event.clientY - press.clientY;
      if (!dragging && Math.hypot(dx, dy) <= 10) return;
      if (!paint && press.pointerType === 'touch' && event.timeStamp - press.timeStamp < touchDragDelayMs) {
        cancelPress();
        return;
      }
      dragging = true;
      hills.drag(dx, dy, event.type === 'pointerup');
      scheduleDraw();
    }

    function handleTouchMove(event: TouchEvent) {
      // A deliberate hold claims the following drag. An immediate swipe scrolls normally.
      if (press && event.touches.length === 1 && event.cancelable &&
          event.timeStamp - press.timeStamp >= touchDragDelayMs) event.preventDefault();
    }

    window.addEventListener('pointerdown', (event) => {
      if (press) cancelPress();
      if (!isBackgroundPress(event)) return;
      press = event;
      dragging = false;
      if (!paint && event.pointerType === 'touch') {
        window.addEventListener('touchmove', handleTouchMove, { ...options, passive: false });
      }
      const bounds = canvas.getBoundingClientRect();
      const swatch = palette?.querySelector<HTMLInputElement>('input:checked');
      const rgb = swatch ? parseInt(swatch.value.slice(1), 16) : null;
      hills.begin(event.clientX - bounds.left, event.clientY - bounds.top, event.timeStamp,
        rgb === null ? undefined : [(rgb >> 16) / 255, ((rgb >> 8) & 255) / 255, (rgb & 255) / 255]);
      scheduleDraw();
    }, options);

    function cancelPress() {
      if (!press) return;
      press = null;
      window.removeEventListener('touchmove', handleTouchMove);
      hills.cancel();
      scheduleDraw();
    }

    window.addEventListener('pointerup', (event) => {
      if (press?.pointerId !== event.pointerId) return;
      updateDrag(event);
      if (!press) return;
      if (event.defaultPrevented || (!dragging && !isBackgroundPress(event))) return cancelPress();
      press = null;
      window.removeEventListener('touchmove', handleTouchMove);
      hills.release(event.timeStamp, reducedMotion.matches);
      scheduleDraw();
    }, options);

    window.addEventListener('pointermove', (event) => {
      if (press?.pointerId === event.pointerId) {
        for (const sample of event.getCoalescedEvents?.() ?? []) updateDrag(sample);
      }
      updateDrag(event);
      if (reducedMotion.matches || event.pointerType === 'touch') return;
      if (previousPointer?.pointerId === event.pointerId) {
        springs.stroke(
          previousPointer.clientX, previousPointer.clientY, event.clientX, event.clientY,
          event.timeStamp - previousPointer.timeStamp,
        );
      }
      previousPointer = event;
    }, options);

    function endStroke() {
      previousPointer = null;
      cancelPress();
    }
    window.addEventListener('pointercancel', endStroke, options);
    document.documentElement.addEventListener('pointerleave', endStroke, options);
    window.addEventListener('blur', endStroke, options);
    reducedMotion.addEventListener('change', resetSprings, options);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelPress();
      cancelAnimationFrame(frame);
      frame = 0;
      lastDraw = 0;
      resetSprings();
    }, options);
    window.addEventListener('resize', resize, options);
    canvas.addEventListener('webglcontextlost', (event) => {
      event.preventDefault();
      if (saveButton) saveButton.disabled = true;
      listeners.abort();
      cancelAnimationFrame(frame);
    }, options);
    resize();
    if (saveButton) {
      saveButton.addEventListener('click', saveImage, options);
      saveButton.disabled = false;
    }
  }

  const canvas = document.querySelector<HTMLCanvasElement>('.contour-background');
  if (canvas) {
    canvas.addEventListener('webglcontextrestored', () => renderContours(canvas));
    renderContours(canvas);
  }
</script>
