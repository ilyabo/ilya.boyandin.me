---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResumeContent from '../components/ResumeContent.astro';
import { getResume, resumeLanguages } from '../lib/resume';
import { pageTitle } from '../lib/seo';

const resumes = await Promise.all(
  resumeLanguages.map(async (language) => ({
    language,
    resume: await getResume(language),
  }))
);
const english = resumes[0].resume;
const german = resumes[1].resume;
---

<BaseLayout
  title={pageTitle(english.ui.title)}
  description={english.ui.description}
  canonicalPath="/resume"
>
  <article class="resume" data-resume-mode="short" lang="en">
    <div class="resume-toolbar">
      <div
        class="resume-controls"
        role="group"
        aria-label={english.ui.lengthLabel}
        data-en-label={english.ui.lengthLabel}
        data-de-label={german.ui.lengthLabel}
      >
        <button type="button" data-resume-mode-button="short" aria-pressed="true">
          {resumes.map(({ language, resume }) => (
            <span data-resume-translation={language} lang={language} hidden={language !== 'en'}>{resume.ui.short}</span>
          ))}
        </button>
        <button type="button" data-resume-mode-button="full" aria-pressed="false">
          {resumes.map(({ language, resume }) => (
            <span data-resume-translation={language} lang={language} hidden={language !== 'en'}>{resume.ui.full}</span>
          ))}
        </button>
      </div>
      <div
        class="resume-controls"
        role="group"
        aria-label={english.ui.languageLabel}
        data-en-label={english.ui.languageLabel}
        data-de-label={german.ui.languageLabel}
      >
        <button type="button" data-resume-language-button="en" aria-pressed="true" lang="en">English</button>
        <button type="button" data-resume-language-button="de" aria-pressed="false" lang="de">Deutsch</button>
      </div>
    </div>

    {resumes.map(({ language, resume }) => (
      <div
        class="resume-content"
        data-resume-translation={language}
        lang={language}
        hidden={language !== 'en'}
        data-page-title={pageTitle(resume.ui.title)}
        data-description={resume.ui.description}
      >
        <ResumeContent resume={resume} language={language} />
      </div>
    ))}
  </article>

  <script>
    import type { ResumeLanguage } from '../lib/resume';

    const resume = document.querySelector<HTMLElement>('[data-resume-mode]');
    if (resume) {
      const modeButtons = resume.querySelectorAll<HTMLButtonElement>('[data-resume-mode-button]');
      const languageButtons = resume.querySelectorAll<HTMLButtonElement>(
        '[data-resume-language-button]'
      );
      const translations = resume.querySelectorAll<HTMLElement>('[data-resume-translation]');
      const controls = resume.querySelectorAll<HTMLElement>('[data-en-label]');

      const setMode = (mode: 'short' | 'full') => {
        resume.dataset.resumeMode = mode;
        modeButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.resumeModeButton === mode));
        });
      };

      const setLanguage = (language: ResumeLanguage) => {
        resume.lang = language;
        translations.forEach((translation) => {
          translation.hidden = translation.dataset.resumeTranslation !== language;
          if (!translation.hidden && translation.dataset.pageTitle) {
            document.title = translation.dataset.pageTitle;
            const description = translation.dataset.description;
            if (description) {
              document.querySelector('meta[name="description"]')?.setAttribute('content', description);
            }
          }
        });
        languageButtons.forEach((button) => {
          button.setAttribute(
            'aria-pressed',
            String(button.dataset.resumeLanguageButton === language)
          );
        });
        controls.forEach((control) => {
          control.setAttribute('aria-label', control.getAttribute(`data-${language}-label`) || '');
        });
      };

      const languageFromUrl = (): ResumeLanguage =>
        new URLSearchParams(window.location.search).get('lang') === 'de' ? 'de' : 'en';
      setLanguage(languageFromUrl());
      window.addEventListener('popstate', () => setLanguage(languageFromUrl()));

      modeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          setMode(button.dataset.resumeModeButton === 'full' ? 'full' : 'short');
        });
      });
      languageButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const language = button.dataset.resumeLanguageButton === 'de' ? 'de' : 'en';
          setLanguage(language);
          const url = new URL(window.location.href);
          if (language === 'en') url.searchParams.delete('lang');
          else url.searchParams.set('lang', language);
          window.history.replaceState(window.history.state, '', url);
        });
      });
    }
  </script>
</BaseLayout>
