---
import CardGrid from '../components/CardGrid.astro';
import KeywordSearch from '../components/KeywordSearch';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntries } from '../lib/content';
import { getKeywordIndex } from '../lib/keyword-search';
import { pageTitle } from '../lib/seo';

const projects = getEntries('projects');
const pinnedKeywords = [
  '3D', 'AI', 'analytics', 'geo', 'open source', 'research', 'DDJ', 'flow maps', 'mobility', 'graphs', 'animation', 'visualization', 'infovis', 'UX'
].sort((a, b) =>
  a.localeCompare(b, undefined, { sensitivity: 'base' })
);;
const { keywords, keywordCounts } = getKeywordIndex(projects, pinnedKeywords);
const title = pageTitle('Projects');
const description = 'Selected interactive maps, geospatial analytics tools, data visualization projects, and exploratory interfaces by Ilya Boyandin.';
---

<BaseLayout title={title} description={description} canonicalPath="/projects">
  <section class="page-section" id="projects">
    <KeywordSearch client:load collection="project" keywords={keywords} keywordCounts={keywordCounts} pinnedKeywords={pinnedKeywords} />
    <CardGrid entries={projects} />
  </section>
</BaseLayout>
