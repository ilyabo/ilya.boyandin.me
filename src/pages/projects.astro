---
import CardGrid from '../components/CardGrid.astro';
import ProjectFilters from '../components/ProjectFilters';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntries } from '../lib/content';
import { pageTitle } from '../lib/seo';

const projects = getEntries('projects');
const pinnedKeywords = ['3D', 'ai', 'analytics', 'geo', 'open source', 'research', 'ddj', 'flow maps', 'mobility', 'graphs', 'animation'].sort();
const keywordLabels = new Map(projects.flatMap((project) =>
  project.keywords.map((keyword) => [keyword.toLowerCase(), keyword] as const)
));
for (const keyword of pinnedKeywords) keywordLabels.set(keyword.toLowerCase(), keyword);
const keywords = [...keywordLabels.values()].sort((a, b) => a.localeCompare(b));
const title = pageTitle('Projects');
const description = 'Selected interactive maps, geospatial analytics tools, data visualization projects, and exploratory interfaces by Ilya Boyandin.';
---

<BaseLayout title={title} description={description} canonicalPath="/projects">
  <section class="page-section" id="projects">
    <ProjectFilters client:load keywords={keywords} pinnedKeywords={pinnedKeywords} />
    <CardGrid entries={projects} />
  </section>
</BaseLayout>
