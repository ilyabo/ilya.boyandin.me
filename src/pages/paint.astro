---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/paint.css';

const colors = [
  ['Terracotta', '#d98b6c'],
  ['Yellow ochre', '#d5aa59'],
  ['Sandstone', '#e5ceab'],
  ['Moss green', '#a5b578'],
  ['Pine green', '#73a48e'],
  ['Slate blue', '#8daac2'],
] as const;
---

<BaseLayout paint canonicalPath="/paint" title="Paint the terrain · Ilya Boyandin" description="Draw colorful hills and valleys on an interactive contour map.">
  <fieldset class="paint-palette" data-paint-palette>
    <legend class="sr-only">Terrain palette</legend>
    {colors.map(([name, hex], index) => (
      <label title={name} style={`--swatch: ${hex}`}>
        <input class="sr-only" type="radio" name="brush-color" value={hex} checked={index === 0} aria-label={name} />
        <span aria-hidden="true"></span>
      </label>
    ))}
    <small class="explore-help">
      <span class="mouse-help">Drag to orbit · WASD to fly · Scroll to zoom</span>
      <span class="touch-help">Drag to orbit · Two fingers to move and zoom</span>
    </small>
    <button type="button" data-explore-terrain disabled aria-label="3D view" aria-pressed="false" title="Explore the terrain in 3D">3D</button>
    <button type="button" data-save-image disabled aria-label="Save image" title="Save image as PNG">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3v12m-4-4 4 4 4-4M4 16v4h16v-4" />
      </svg>
    </button>
  </fieldset>
</BaseLayout>
