---
import BaseLayout from '../layouts/BaseLayout.astro';

const colors = [
  ['Turquoise', '#32ffcf'],
  ['Sky blue', '#46bcff'],
  ['Violet', '#b389ff'],
  ['Pink', '#ff69c2'],
  ['Coral', '#ff795e'],
  ['Sunflower', '#ffdb4a'],
] as const;
---

<BaseLayout paint canonicalPath="/paint" title="Paint the terrain · Ilya Boyandin" description="Draw colorful hills and valleys on an interactive contour map.">
  <fieldset class="palette" data-paint-palette>
    <legend class="sr-only">Brush color</legend>
    {colors.map(([name, hex], index) => (
      <label title={name} style={`--swatch: ${hex}`}>
        <input class="sr-only" type="radio" name="brush-color" value={hex} checked={index === 0} aria-label={name} />
        <span aria-hidden="true"></span>
      </label>
    ))}
  </fieldset>
</BaseLayout>

<style>
  :global(html.paint-page) {
    overflow: hidden;
    overscroll-behavior: none;
    scrollbar-gutter: auto;
  }
  :global(.paint-page body) {
    height: 100dvh;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  :global(.paint-page astro-dev-toolbar) {
    display: none;
  }
  :global(.paint-page .site-main) {
    width: 100%;
    max-width: none;
    padding: 0;
    flex: 1;
    cursor: crosshair;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .palette {
    position: fixed;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    padding: 0.25rem;
    margin: 0;
    border: 1px solid var(--color-site-border);
    border-radius: 2rem;
    background: var(--color-site-bg-deep);
    cursor: default;
  }
  .palette label {
    display: grid;
    place-items: center;
    width: min(2.75rem, 14vw);
    height: 2.75rem;
    cursor: pointer;
  }
  .palette span {
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 50%;
    background: var(--swatch);
  }
  input:checked + span {
    outline: 2px solid var(--swatch);
    outline-offset: 3px;
  }
  input:focus-visible + span {
    outline: 3px dashed white;
    outline-offset: 4px;
  }
</style>
