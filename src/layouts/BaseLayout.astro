---
import { ClientRouter } from 'astro:transitions';
import SiteTooltips from '../components/SiteTooltips';
import ContourBackground from '../components/ContourBackground.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Footer from '../components/Footer.astro';
import criticalCss from '../styles/critical.css?raw';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string | null;
  type?: string;
  jsonLd?: Record<string, unknown> | null;
  paint?: boolean;
}

const siteUrl = 'https://ilya.boyandin.me';
const {
  title = 'Ilya Boyandin - Data Visualization Engineer',
  description = 'I develop interactive maps and data visualizations for the web.',
  canonicalPath = Astro.url.pathname,
  image = `${siteUrl}/profile-pic.jpg`,
  type = 'website',
  jsonLd = null,
  paint = false,
} = Astro.props;

const normalizedCanonicalPath = canonicalPath === '/' ? '/' : canonicalPath.replace(/\/$/, '');
const canonicalUrl = normalizedCanonicalPath === '/' ? `${siteUrl}/` : `${siteUrl}${normalizedCanonicalPath}`;
const activePath = normalizedCanonicalPath;

function isActive(path: string) {
  if (path === '/') return activePath === '/';
  return activePath === path || activePath.startsWith(`${path}/`);
}
---

<!doctype html>
<html lang="en" transition:animate="none" class:list={[{ 'paint-page': paint }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <style is:inline set:html={criticalCss} />
    <ClientRouter fallback="swap" />
    <script>
      document.addEventListener('astro:after-swap', () => {
        // Chrome can reject video sources while Astro parses the incoming document offscreen.
        for (const video of document.querySelectorAll('video')) {
          if (!video.currentSrc) video.load();
        }
      });
    </script>
    <title>{title}</title>
    <link rel="icon" href="/favicon.png" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image ? <meta property="og:image" content={image} /> : null}
    {image ? <meta name="twitter:card" content="summary_large_image" /> : null}
    {image ? <meta name="twitter:image" content={image} /> : null}
    {jsonLd ? <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} /> : null}
  </head>
  <body>
    <ContourBackground />
    <SiteTooltips client:load />
    <header class="site-header">
      <div class="header-inner">
        <nav class="site-nav" aria-label="Main navigation">
          {[
            { label: 'Home', href: '/' },
            { label: 'Projects', href: '/projects' },
            { label: 'Talks', href: '/talks' },
            { label: 'Music', href: '/music' },
          ].map(({ label, href }) => (
            <a class="nav-link" href={href} aria-current={
              activePath === href ? 'page' :
              isActive(href) || (href === '/projects' && isActive('/p')) ? 'location' : undefined
            }>{label}</a>
          ))}
          <a class="nav-link" href="/paint" aria-label="Paint the terrain" data-tooltip="Paint the terrain" aria-current={paint ? 'page' : undefined}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9.5 12.5C12 8.8 18.6 2 20.7 2.5c2.1.6-2.9 8.1-7.4 12.1z" />
              <path d="M10 13c-2.2-.9-4.5.5-4.6 2.8-.2 2.1-1.3 3.6-3.1 4 3.3 1.8 7.5 1.2 9.2-1.4 1.3-2 .7-4.4-1.5-5.4z" />
            </svg>
          </a>
        </nav>
        <SocialLinks icons />
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    {!paint && <Footer />}
  </body>
</html>
